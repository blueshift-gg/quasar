import { type Address, address, AccountRole, type Instruction, getProgramDerivedAddress, getAddressCodec, type ClientWithRpc, type GetAccountInfoApi, type GetMultipleAccountsApi, type ClientWithPayer, type ClientWithTransactionPlanning, type ClientWithTransactionSending } from "@solana/kit";
import { addSelfFetchFunctions, addSelfPlanAndSendFunctions } from "@solana/kit/program-client-core";
import { getBooleanCodec, getNullableCodec, getStructCodec, getU64Codec, getU8Codec } from "@solana/codecs";

function matchDisc(data: Uint8Array, disc: Uint8Array): boolean {
  if (data.length < disc.length) return false;
  for (let i = 0; i < disc.length; i++) {
    if (data[i] !== disc[i]) return false;
  }
  return true;
}

const MAX_DECODE_ELEMENTS = 10 * 1024 * 1024;

function checkedLength(value: number | bigint): number {
  const result = Number(value);
  if (!Number.isSafeInteger(result) || result < 0) throw new Error("invalid length prefix");
  return result;
}

function checkedElementCount(value: number | bigint, remaining: number): number {
  const result = checkedLength(value);
  if (result > MAX_DECODE_ELEMENTS || result > remaining) {
    throw new Error("element count exceeds limit");
  }
  return result;
}

function checkedTake(data: Uint8Array, offset: number, size: number): Uint8Array {
  if (!Number.isSafeInteger(offset) || !Number.isSafeInteger(size) || offset < 0 || size < 0 || size > data.length - offset) {
    throw new Error("truncated input");
  }
  return data.slice(offset, offset + size);
}

function decodeUtf8(data: Uint8Array): string {
  return new TextDecoder("utf-8", { fatal: true }).decode(data);
}

function unwrapOption<T>(value: unknown): T | null {
  if (typeof value === "object" && value !== null && "__option" in value) {
    const option = value as { __option: string; value?: T };
    if (option.__option === "None") return null;
    if (option.__option === "Some") return option.value as T;
    throw new Error("invalid option tag");
  }
  return value as T | null;
}

function codecSize(
  codec: { encode(value: any): ArrayLike<number> },
  value: unknown,
): number {
  const fixedSize = (codec as { fixedSize?: unknown }).fixedSize;
  return typeof fixedSize === "number" ? fixedSize : codec.encode(value).length;
}

function bytesEqual(left: ArrayLike<number>, right: ArrayLike<number>): boolean {
  if (left.length !== right.length) return false;
  for (let index = 0; index < left.length; index++) {
    if (left[index] !== right[index]) return false;
  }
  return true;
}

function decodeExact<T>(
  codec: { decode(data: Uint8Array): unknown; encode(value: any): ArrayLike<number> },
  data: Uint8Array,
): T {
  const value = codec.decode(data);
  if (!bytesEqual(codec.encode(value), data)) throw new Error("invalid or trailing bytes");
  return value as T;
}

function assertFinished(data: Uint8Array, offset: number): void {
  if (offset !== data.length) throw new Error("trailing bytes");
}

/* Constants */
export const PROGRAM_ADDRESS = address("11111111111111111111111111111111");
export const VAULT_DISCRIMINATOR = new Uint8Array([42]);
export const POOL_DISCRIMINATOR = new Uint8Array([43]);
export const VAULT_MADE_DISCRIMINATOR = new Uint8Array([7]);
export const MAKE_INSTRUCTION_DISCRIMINATOR = new Uint8Array([0]);
export const SYNC_INSTRUCTION_DISCRIMINATOR = new Uint8Array([1]);
export const SETTLE_INSTRUCTION_DISCRIMINATOR = new Uint8Array([2]);

/* Interfaces */
export interface Vault {
  authority: Address;
  amount: bigint;
  mode: number;
}

export interface Mode {
}

export interface Pool {
  seed: bigint;
  authority: Address;
}

export interface MakeInstructionArgs {
  amount: bigint;
  flag: boolean;
}

export interface SettleInstructionArgs {
  target: Address;
  amount: bigint;
  bonus: bigint | null;
}

export interface MakeInstructionInput {
  authority: Address;
  amount: bigint;
  flag: boolean;
}

export interface SyncInstructionInput {
  authority: Address;
  poolSeed: bigint;
}

export interface SettleInstructionInput {
  payer: Address;
  mint: Address;
  maybeRefund?: Address;
  target: Address;
  amount: bigint;
  bonus: bigint | null;
}

export interface MakeInstructionAccountOverrides {
  authority?: Address;
  vault?: Address;
}

export interface SyncInstructionAccountOverrides {
  authority?: Address;
  pool?: Address;
}

export interface SettleInstructionAccountOverrides {
  payer?: Address;
  mint?: Address;
  tokenProgram?: Address;
  recipient?: Address;
  payerTokens?: Address;
  maybeRefund?: Address;
}

/* Codecs */
const VaultStructCodec = getStructCodec([
  ["authority", getAddressCodec()],
  ["amount", getU64Codec()],
  ["mode", getU8Codec()],
]);
export const VaultCodec = {
  ...VaultStructCodec,
  decode(data: Parameters<typeof VaultStructCodec.decode>[0], offset = 0): Vault { return decodeExact<Vault>(VaultStructCodec, Uint8Array.from(data).slice(offset)); },
};

const ModeStructCodec = getStructCodec([
]);
export const ModeCodec = {
  ...ModeStructCodec,
  decode(data: Parameters<typeof ModeStructCodec.decode>[0], offset = 0): Mode { return decodeExact<Mode>(ModeStructCodec, Uint8Array.from(data).slice(offset)); },
};

const PoolStructCodec = getStructCodec([
  ["seed", getU64Codec()],
  ["authority", getAddressCodec()],
]);
export const PoolCodec = {
  ...PoolStructCodec,
  decode(data: Parameters<typeof PoolStructCodec.decode>[0], offset = 0): Pool { return decodeExact<Pool>(PoolStructCodec, Uint8Array.from(data).slice(offset)); },
};

/* Account Codecs */
export const VaultAccount = {
  decode: VaultCodec.decode,
  encode: VaultCodec.encode,
  owner: PROGRAM_ADDRESS,
  discriminator: VAULT_DISCRIMINATOR,
  size: 42,
} as const;

export const PoolAccount = {
  decode: PoolCodec.decode,
  encode: PoolCodec.encode,
  owner: PROGRAM_ADDRESS,
  discriminator: POOL_DISCRIMINATOR,
  size: 41,
} as const;

/* Enums */
export const ProgramEvent = {
  VaultMade: "VaultMade",
} as const;

export type ProgramEvent =
  (typeof ProgramEvent)[keyof typeof ProgramEvent];

export type DecodedEvent =
  | { type: typeof ProgramEvent.VaultMade };

export const ProgramInstruction = {
  Make: "Make",
  Sync: "Sync",
  Settle: "Settle",
} as const;

export type ProgramInstruction =
  (typeof ProgramInstruction)[keyof typeof ProgramInstruction];

export type DecodedInstruction =
  | { type: typeof ProgramInstruction.Make; args: MakeInstructionArgs }
  | { type: typeof ProgramInstruction.Sync }
  | { type: typeof ProgramInstruction.Settle; args: SettleInstructionArgs };

/* Client */
export class GoldenDemoClient {

  decodeVault(input: ArrayLike<number>): Vault {
    const data = Uint8Array.from(input);
    if (!matchDisc(data, VAULT_DISCRIMINATOR)) throw new Error("Invalid Vault discriminator");
    return decodeExact<Vault>(VaultCodec, data.slice(VAULT_DISCRIMINATOR.length));
  }

  decodePool(input: ArrayLike<number>): Pool {
    const data = Uint8Array.from(input);
    if (!matchDisc(data, POOL_DISCRIMINATOR)) throw new Error("Invalid Pool discriminator");
    return decodeExact<Pool>(PoolCodec, data.slice(POOL_DISCRIMINATOR.length));
  }

  decodeEvent(input: ArrayLike<number>): DecodedEvent | null {
    const data = Uint8Array.from(input);
    if (matchDisc(data, VAULT_MADE_DISCRIMINATOR)) {
      if (data.length !== VAULT_MADE_DISCRIMINATOR.length) throw new Error("trailing bytes");
      return { type: ProgramEvent.VaultMade };
    }
    return null;
  }

  decodeInstruction(input: ArrayLike<number>): DecodedInstruction | null {
    const data = Uint8Array.from(input);
    if (matchDisc(data, MAKE_INSTRUCTION_DISCRIMINATOR)) {
      const argsCodec = getStructCodec([
        ["amount", getU64Codec()],
        ["flag", getBooleanCodec()],
      ]);
      return { type: ProgramInstruction.Make, args: decodeExact<MakeInstructionArgs>(argsCodec, data.slice(MAKE_INSTRUCTION_DISCRIMINATOR.length)) };
    }
    if (matchDisc(data, SYNC_INSTRUCTION_DISCRIMINATOR)) {
      if (data.length !== SYNC_INSTRUCTION_DISCRIMINATOR.length) throw new Error("trailing bytes");
      return { type: ProgramInstruction.Sync };
    }
    if (matchDisc(data, SETTLE_INSTRUCTION_DISCRIMINATOR)) {
      const argsCodec = getStructCodec([
        ["target", getAddressCodec()],
        ["amount", getU64Codec()],
        ["bonus", getNullableCodec(getU64Codec())],
      ]);
      return { type: ProgramInstruction.Settle, args: decodeExact<SettleInstructionArgs>(argsCodec, data.slice(SETTLE_INSTRUCTION_DISCRIMINATOR.length)) };
    }
    return null;
  }

  async createMakeInstruction(input: MakeInstructionInput): Promise<Instruction & { readonly vaultAddress: Address }> {
    return this.createMakeInstructionRaw(input, {});
  }

  async createMakeInstructionRaw(input: MakeInstructionInput, accountOverrides: MakeInstructionAccountOverrides): Promise<Instruction & { readonly vaultAddress: Address }> {
    const __vault: Address = await findVaultAddress((accountOverrides.authority ?? input.authority));
    const argsCodec = getStructCodec([
      ["amount", getU64Codec()],
      ["flag", getBooleanCodec()],
    ]);
    const data = Uint8Array.from([0, ...argsCodec.encode({ amount: input.amount, flag: input.flag })]);
    return {
      programAddress: PROGRAM_ADDRESS,
      accounts: [
        { address: (accountOverrides.authority ?? input.authority), role: AccountRole.READONLY_SIGNER },
        { address: (accountOverrides.vault ?? __vault), role: AccountRole.WRITABLE },
      ],
      data,
      vaultAddress: (accountOverrides.vault ?? __vault),
    };
  }

  async createSyncInstruction(input: SyncInstructionInput): Promise<Instruction & { readonly poolAddress: Address }> {
    return this.createSyncInstructionRaw(input, {});
  }

  async createSyncInstructionRaw(input: SyncInstructionInput, accountOverrides: SyncInstructionAccountOverrides): Promise<Instruction & { readonly poolAddress: Address }> {
    const __pool: Address = (await getProgramDerivedAddress({
      programAddress: PROGRAM_ADDRESS,
      seeds: [
        new Uint8Array([112, 111, 111, 108]),
        getU64Codec().encode(input.poolSeed),
      ],
    }))[0];
    const data = Uint8Array.from([1]);
    return {
      programAddress: PROGRAM_ADDRESS,
      accounts: [
        { address: (accountOverrides.authority ?? input.authority), role: AccountRole.READONLY_SIGNER },
        { address: (accountOverrides.pool ?? __pool), role: AccountRole.WRITABLE },
      ],
      data,
      poolAddress: (accountOverrides.pool ?? __pool),
    };
  }

  async createSettleInstruction(input: SettleInstructionInput): Promise<Instruction & { readonly payerTokensAddress: Address }> {
    return this.createSettleInstructionRaw(input, {});
  }

  async createSettleInstructionRaw(input: SettleInstructionInput, accountOverrides: SettleInstructionAccountOverrides): Promise<Instruction & { readonly payerTokensAddress: Address }> {
    const __tokenProgram: Address = address("TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA");
    const __recipient: Address = input.target;
    const __payerTokens: Address = (await getProgramDerivedAddress({
      programAddress: address("ATokenGPvbdGVxr1b2hvZbsiqW5xWH25efTNsLJA8knL"),
      seeds: [getAddressCodec().encode((accountOverrides.payer ?? input.payer)), getAddressCodec().encode((accountOverrides.tokenProgram ?? __tokenProgram)), getAddressCodec().encode((accountOverrides.mint ?? input.mint))],
    }))[0];
    const argsCodec = getStructCodec([
      ["target", getAddressCodec()],
      ["amount", getU64Codec()],
      ["bonus", getNullableCodec(getU64Codec())],
    ]);
    const data = Uint8Array.from([2, ...argsCodec.encode({ target: input.target, amount: input.amount, bonus: input.bonus })]);
    return {
      programAddress: PROGRAM_ADDRESS,
      accounts: [
        { address: (accountOverrides.payer ?? input.payer), role: AccountRole.WRITABLE_SIGNER },
        { address: (accountOverrides.mint ?? input.mint), role: AccountRole.READONLY },
        { address: (accountOverrides.tokenProgram ?? __tokenProgram), role: AccountRole.READONLY },
        { address: (accountOverrides.recipient ?? __recipient), role: AccountRole.READONLY },
        { address: (accountOverrides.payerTokens ?? __payerTokens), role: AccountRole.WRITABLE },
        { address: (accountOverrides.maybeRefund ?? input.maybeRefund ?? PROGRAM_ADDRESS), role: AccountRole.READONLY },
      ],
      data,
      payerTokensAddress: (accountOverrides.payerTokens ?? __payerTokens),
    };
  }
}

/* Program Plugin */
export type GoldenDemoPluginRequirements = ClientWithRpc<GetAccountInfoApi & GetMultipleAccountsApi> &
  ClientWithPayer &
  ClientWithTransactionPlanning &
  ClientWithTransactionSending;

export function goldenDemoProgram() {
  const __client = new GoldenDemoClient();
  return <T extends GoldenDemoPluginRequirements>(client: T) => ({
    ...client,
    goldenDemo: {
      accounts: {
        vault: addSelfFetchFunctions(client, VaultCodec),
        pool: addSelfFetchFunctions(client, PoolCodec),
      },
      instructions: {
        make: (input: MakeInstructionInput) => addSelfPlanAndSendFunctions(client, __client.createMakeInstruction(input)),
        sync: (input: SyncInstructionInput) => addSelfPlanAndSendFunctions(client, __client.createSyncInstruction(input)),
        settle: (input: SettleInstructionInput) => addSelfPlanAndSendFunctions(client, __client.createSettleInstruction(input)),
      },
    },
  });
}

/* PDA Helpers */
export async function findVaultAddress(authority: Address): Promise<Address> {
  return (await getProgramDerivedAddress({
    programAddress: PROGRAM_ADDRESS,
    seeds: [
        new Uint8Array([118, 97, 117, 108, 116]),
      getAddressCodec().encode(authority),
    ],
  }))[0];
}

/* Errors */
export const PROGRAM_ERROR_CODES = {
  Unauthorized: 6000,
} as const;

export const PROGRAM_ERRORS: Record<number, { name: string; msg?: string }> = {
  6000: { name: "Unauthorized", msg: "caller is not the vault authority" },
};
